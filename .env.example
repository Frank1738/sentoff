# All optional. The app runs without them: roasts fall back to template lines
# and the cache falls back to an in-memory map.
# Roast writer. Groq is used when its key is set (free tier at console.groq.com),
# Claude otherwise. GROQ_MODEL is optional and overrides the default Llama model.
GROQ_API_KEY=
GROQ_MODEL=
ANTHROPIC_API_KEY=
# Redis. On Vercel the Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN,
# which also work. Leave both pairs empty locally to use the in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
